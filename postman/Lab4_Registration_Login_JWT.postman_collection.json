    {
      "name": "4. POST Login - Success (Generates JWT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.jwt_token) {",
              "    pm.collectionVariables.set('jwt_token', jsonData.jwt_token);",
              "    console.log('JWT Token successfully set in collection variable:', jsonData.jwt_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"geethashree\",\n  \"password\": \"securePass123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        },
        "description": "Authenticates valid credentials, compares bcrypt hash, and returns JWT token."
